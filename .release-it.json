{
	"$schema": "https://unpkg.com/release-it@21/schema/release-it.json",
	"git": {
		"requireBranch": "main",
		"requireCleanWorkingDir": true,
		"requireUpstream": true,
		"requireCommits": true,
		"changelog": "npx auto-changelog --stdout --unreleased --commit-limit false -u --hide-credit"
	},
	"github": {
		"release": false
	},
	"npm": {
		"publish": false
	},
	"hooks": {
		"before:init": "npm run lint && npm run build",
		"after:bump": "npx auto-changelog -p --commit-limit false"
	}
}
