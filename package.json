{
	"name": "@afges/n8n-nodes-amalia",
	"version": "0.4.0",
	"description": "Node for utilizing data from the AMALIA registry.",
	"license": "MIT",
	"homepage": "https://github.com/AFGES/n8n-nodes-amalia#readme",
	"keywords": [
		"n8n-community-node-package"
	],
	"author": {
		"name": "Charles LESECQ",
		"email": "charles.lesecq@afges.org"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/AFGES/n8n-nodes-amalia.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"postbuild": "node -e \"const{cpSync}=require('fs');try{cpSync('nodes/Amalia/translations','dist/nodes/Amalia/translations',{recursive:true})}catch(e){if(e.code!=='ENOENT')throw e}\"",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"check": "vp check",
		"check:fix": "vp check --fix",
		"format": "vp fmt",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/AmaliaApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Amalia/Amalia.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.55.0",
		"release-it": "^21.1.2",
		"typescript": "6.0.3",
		"vite-plus": "1.5.0"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
